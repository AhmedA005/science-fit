# ─────────────────────────────────────────────────────────────
# Science-Fit — Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=sciencefit
POSTGRES_PASSWORD=             # REQUIRED — no default, set your own password
POSTGRES_DB=sciencefit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=fitness_evidence

# ── Ollama Cloud API ──────────────────────────────────────────
# Get your API key from: https://ollama.com
# Usage in code:
#   client = Client(host='https://ollama.com', headers={'Authorization': 'Bearer <key>'})
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=             # REQUIRED — your Ollama API key
OLLAMA_LLM_MODEL=gemma4     # see https://ollama.com/library/gemma4
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
